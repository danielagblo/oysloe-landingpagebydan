# Environment Variables for DigitalOcean Deployment
# Copy this file to .env and fill in your actual values

# Django Settings
DJANGO_SECRET_KEY=your-super-secret-key-here-change-this-in-production
DJANGO_SETTINGS_MODULE=project.settings_production

# Database Configuration (PostgreSQL)
DB_NAME=oysloe_db
DB_USER=postgres
DB_PASSWORD=your-database-password-here
DB_HOST=your-database-host-here
DB_PORT=5432

# Production Domain
PRODUCTION_DOMAIN=your-domain.com

# Optional: Email Configuration (if you plan to add email features)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# Optional: Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0

# Optional: AWS S3 Configuration (for file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=us-east-1
