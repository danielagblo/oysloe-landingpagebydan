[Unit]
Description=Oysloe Landing Page Frontend (React + Serve)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/oysloe-landing-page
Environment=NODE_ENV=production
ExecStart=/usr/bin/npx serve -s dist -l 3000
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true

[Install]
WantedBy=multi-user.target
