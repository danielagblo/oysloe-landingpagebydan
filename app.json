{
  "name": "oysloe-landingpage",
  "region": "nyc",
  "services": [
    {
      "name": "backend",
      "github": {
        "repo": "danielagblo/oysloe-landingpagebydan",
        "branch": "main",
        "deploy_on_push": true
      },
      "build_command": "cd backend && bash ./build.sh",
      "run_command": "cd backend && gunicorn project.wsgi:application --config gunicorn_config.py",
      "environment_slug": "python",
      "envs": [
        {
          "key": "PYTHONPATH",
          "value": "/app/backend"
        },
        {
          "key": "SECRET_KEY",
          "scope": "RUN_AND_BUILD",
          "type": "SECRET"
        },
        {
          "key": "DEBUG",
          "value": "False"
        },
        {
          "key": "ALLOWED_HOSTS",
          "value": "oysloelandingpage-cw9m3.ondigitalocean.app"
        },
        {
          "key": "DATABASE_URL",
          "scope": "RUN_AND_BUILD",
          "type": "SECRET"
        },
        {
          "key": "CORS_ALLOWED_ORIGINS",
          "value": "https://oysloelandingpage-cw9m3.ondigitalocean.app"
        },
        {
          "key": "CORS_ALLOW_ALL_ORIGINS",
          "value": "False"
        },
        {
          "key": "SECURE_SSL_REDIRECT",
          "value": "True"
        }
      ],
      "instance_size_slug": "basic-xxs",
      "instance_count": 1
    }
  ],
  "databases": [
    {
      "name": "db",
      "engine": "PG",
      "version": "12"
    }
  ]
}

